@inherits LayoutComponentBase

<header class="fixed top-0 w-full z-50 flex items-center justify-between px-5 py-4 md:px-12" style="background-color: rgba(8, 8, 8, 0.95); backdrop-filter: blur(8px); border-bottom: 1px solid #1a1a1a;">
    <a href="/" class="text-xl font-black uppercase tracking-widest no-underline" style="font-family: 'Barlow Condensed', sans-serif; color: #f0f0f0;">
