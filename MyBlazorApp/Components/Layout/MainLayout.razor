        </a>
        <a href="/contact" class="px-6 py-2.5 text-xs font-semibold uppercase tracking-widest no-underline transition-colors duration-200 hover:bg-red-700" style="background-color: #c8002a; color: #fff; font-family: 'DM Sans', sans-serif; letter-spacing: 0.14em;">
