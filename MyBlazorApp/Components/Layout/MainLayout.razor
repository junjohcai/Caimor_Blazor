        </a>
        <a href="/inventory" class="text-xs font-semibold uppercase tracking-widest no-underline transition-colors hover:text-white" style="color: #aaa; font-family: 'DM Sans', sans-serif; letter-spacing: 0.14em;">
            Inventory
        </a>
        <a href="/contact" class="text-xs font-semibold uppercase tracking-widest no-underline transition-colors hover:text-white" style="color: #aaa; font-family: 'DM Sans', sans-serif; letter-spacing: 0.14em;">
