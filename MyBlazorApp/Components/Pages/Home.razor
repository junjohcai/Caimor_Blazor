@page "/"

@* Hero Section *@
<section class="relative min-h-[85vh] flex items-end pb-20 overflow-hidden">
    @* Background Video (or Image) *@
    <video class="absolute inset-0 w-full h-full object-cover" autoplay loop muted playsinline>
        <source src="/cars-bg.mp4" type="video/mp4">
    </video>
    
    @* Dark Gradient Overlay *@
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(8,8,8,1)_0%,rgba(8,8,8,0.5)_25%,transparent_55%)]"></div>

    <div class="relative z-10 w-full px-6 md:px-12 lg:pr-1/2">
        <p class="text-sm uppercase tracking-[0.22em] mb-4 text-[#c8002a] font-['DM_Sans',sans-serif]">
            Premium Automotive
        </p>
        <h1 class="font-black uppercase leading-none mb-8 text-[#f0f0f0] font-['Barlow_Condensed',sans-serif] text-[clamp(3rem,6vw,6rem)] tracking-tight">
            Drive What<br />
            <span class="text-[#c8002a]">Moves</span> You.
        </h1>
        <p class="text-base mb-10 max-w-lg text-neutral-400 font-['DM_Sans',sans-serif] leading-relaxed">
            Apex Motors curates the world's finest performance and luxury vehicles — because the right car isn't just transportation, it's identity.
        </p>
        <div class="flex flex-wrap gap-4">
            <a href="/inventory"
               class="px-8 py-4 font-semibold uppercase tracking-[0.14em] text-white bg-[#c8002a] hover:bg-red-700 transition-colors duration-200 font-['DM_Sans',sans-serif]">
                Browse Inventory
            </a>
            <a href="/contact"
               class="px-8 py-4 font-semibold uppercase tracking-[0.14em] text-neutral-400 border border-neutral-700 hover:border-white hover:text-white transition-all duration-200 font-['DM_Sans',sans-serif]">
                Book Test Drive
            </a>
        </div>
    </div>
</section>

@* Stats Bar *@
<section class="bg-[#111] border-y border-neutral-900">
    <div class="max-w-6xl mx-auto px-8 py-10 grid grid-cols-2 md:grid-cols-4 gap-8">
        @foreach (var s in stats)
        {
            <div class="text-center group cursor-default">
                <p class="font-black text-4xl mb-1 text-[#f0f0f0] font-['Barlow_Condensed',sans-serif] group-hover:text-[#c8002a] transition-colors duration-300">
                    @s.Value
                </p>
                <p class="text-sm uppercase tracking-[0.14em] text-neutral-500 font-['DM_Sans',sans-serif]">
                    @s.Label
                </p>
            </div>
        }
    </div>
</section>

@* Featured Vehicles *@
<section class="max-w-6xl mx-auto px-8 py-24">
    <div class="flex items-end justify-between mb-12">
        <div>
            <p class="text-sm uppercase tracking-[0.22em] mb-3 text-[#c8002a] font-['DM_Sans',sans-serif]">
                Hand-selected
            </p>
            <h2 class="font-black uppercase leading-none text-[#f0f0f0] font-['Barlow_Condensed',sans-serif] text-[clamp(2.5rem,5vw,4.5rem)]">
                Featured Vehicles
            </h2>
        </div>
        <a href="/inventory"
           class="hidden md:block text-sm font-medium uppercase tracking-[0.14em] text-neutral-500 hover:text-white transition-colors duration-200 font-['DM_Sans',sans-serif]">
            View all →
        </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
        @foreach (var car in featured)
        {
            <a href="/inventory" class="group block bg-[#111] border border-transparent hover:border-neutral-800 transition-colors duration-300">
                <div class="overflow-hidden mb-4 aspect-[16/10] bg-neutral-900">
                    <img src="@car.Img" alt="@car.Name"
                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <div class="px-2 pb-2">
                    <div class="flex items-start justify-between mb-2">
                        <div>
                            <span class="text-xs uppercase tracking-[0.14em] px-2 py-1 mr-2 text-white bg-[#c8002a] font-['DM_Sans',sans-serif]">
                                @car.Tag
                            </span>
                            <span class="text-xs text-neutral-500 font-['DM_Sans',sans-serif]">
                                @car.Year
                            </span>
                        </div>
                        <span class="font-black text-xl text-[#f0f0f0] font-['Barlow_Condensed',sans-serif]">
                            @car.Price
                        </span>
                    </div>
                    <h3 class="font-bold text-xl mb-3 text-neutral-300 group-hover:text-white transition-colors duration-200 font-['Barlow_Condensed',sans-serif] tracking-wide">
                        @car.Name
                    </h3>
                    <div class="flex gap-3">
                        @foreach (var spec in car.Specs)
                        {
                            <span class="text-xs px-2 py-1 bg-neutral-900 text-neutral-400 font-['DM_Sans',sans-serif]">
                                @spec
                            </span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
</section>

@* CTA Banner *@
<section class="mx-8 mb-16 px-12 py-16 flex flex-col md:flex-row items-center justify-between gap-8 bg-[#c8002a]">
    <div>
        <h2 class="font-black uppercase leading-none text-white mb-2 font-['Barlow_Condensed',sans-serif] text-[clamp(2rem,4vw,3.5rem)]">
            Ready to find your perfect drive?
        </h2>
        <p class="text-white/75 font-['DM_Sans',sans-serif]">
            Our specialists are standing by. No pressure, just passion.
        </p>
    </div>
    <a href="/contact"
       class="shrink-0 px-8 py-4 font-semibold uppercase tracking-[0.14em] text-[#080808] bg-white hover:bg-neutral-200 transition-colors duration-200 font-['DM_Sans',sans-serif]">
        Get in Touch
    </a>
</section>

@code {
    public class Stat
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }

    public class Car
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int Year { get; set; }
        public string Price { get; set; } = "";
        public string Tag { get; set; } = "";
        public string Img { get; set; } = "";
        public List<string> Specs { get; set; } = new();
    }

    private List<Stat> stats = new()
    {
        new Stat { Value = "500+", Label = "Vehicles in Stock" },
        new Stat { Value = "12 Yrs", Label = "In Business" },
        new Stat { Value = "4.9★", Label = "Average Rating" },
        new Stat { Value = "98%", Label = "Customer Satisfaction" }
    };

    private List<Car> featured = new()
    {
        new Car { Id = 1, Name = "Porsche 911 GT3", Year = 2025, Price = "$189,500", Tag = "New Arrival", Img = "https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?w=700&h=450&fit=crop&auto=format", Specs = new List<string> { "4.0L Flat-6", "510 hp", "PDK 7-speed" } },
        new Car { Id = 2, Name = "BMW M4 Competition", Year = 2024, Price = "$94,800", Tag = "Featured", Img = "https://images.unsplash.com/photo-1555215695-3004980ad54e?w=700&h=450&fit=crop&auto=format", Specs = new List<string> { "3.0L Twin-Turbo", "503 hp", "M xDrive" } },
        new Car { Id = 3, Name = "Mercedes AMG GT", Year = 2024, Price = "$143,200", Tag = "Hot Deal", Img = "https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?w=700&h=450&fit=crop&auto=format", Specs = new List<string> { "4.0L Biturbo V8", "577 hp", "AMG Speedshift" } }
    };
}