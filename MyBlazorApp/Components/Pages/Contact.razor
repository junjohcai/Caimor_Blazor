@page "/contact"

<div class="pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-8">
        <div class="mb-14">
            <p class="text-sm uppercase tracking-[0.22em] mb-3 text-[#c8002a] font-['DM_Sans',sans-serif]">
                Get in touch
            </p>
            <h1 class="font-black uppercase leading-none text-[#f0f0f0] font-['Barlow_Condensed',sans-serif] text-5xl md:text-7xl">
                Book a Test Drive
            </h1>
        </div>

        <div class="grid md:grid-cols-2 gap-16">
            @* Form Area *@
            <div>
                @if (isSubmitted)
                {
                    <div class="h-full flex flex-col items-start justify-center py-16 border-l-4 border-[#c8002a] pl-8">
                        <p class="font-black uppercase text-4xl mb-4 text-[#f0f0f0] font-['Barlow_Condensed',sans-serif]">
                            Request Received
                        </p>
                        <p class="text-neutral-400 font-['DM_Sans',sans-serif] leading-relaxed">
                            Thank you, @(string.IsNullOrWhiteSpace(form.Name) ? "there" : form.Name). One of our specialists will reach out to you within 24 hours to confirm your test drive appointment.
                        </p>
                        <button @onclick="ResetForm"
                                class="mt-8 px-6 py-3 text-sm font-semibold uppercase tracking-[0.14em] text-white bg-[#c8002a] hover:bg-red-700 transition-colors duration-200">
                            Submit Another
                        </button>
                    </div>
                }
                else
                {
                    <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="flex flex-col gap-5">
                        <div class="grid sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs uppercase tracking-[0.14em] text-neutral-500 mb-1.5 font-['DM_Sans',sans-serif]">
                                    Full Name *
                                </label>
                                <input @bind="form.Name" required placeholder="James Anderson"
                                       class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] transition-colors" />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-[0.14em] text-neutral-500 mb-1.5 font-['DM_Sans',sans-serif]">
                                    Email *
                                </label>
                                <input type="email" @bind="form.Email" required placeholder="james@email.com"
                                       class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] transition-colors" />
                            </div>
                        </div>

                        <div class="grid sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs uppercase tracking-[0.14em] text-neutral-500 mb-1.5 font-['DM_Sans',sans-serif]">
                                    Phone
                                </label>
                                <input type="tel" @bind="form.Phone" placeholder="+1 (310) 555-0000"
                                       class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] transition-colors" />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-[0.14em] text-neutral-500 mb-1.5 font-['DM_Sans',sans-serif]">
                                    Preferred Date
                                </label>
                                <input type="date" @bind="form.Date"
                                       class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] [color-scheme:dark] transition-colors" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-[0.14em] text-neutral-500 mb-1.5 font-['DM_Sans',sans-serif]">
                                Vehicle of Interest
                            </label>
                            <select @bind="form.Vehicle"
                                    class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] cursor-pointer transition-colors">
                                <option value="">Select a vehicle…</option>
                                <option>Porsche 911 GT3 (2025)</option>
                                <option>BMW M4 Competition (2024)</option>
                                <option>Mercedes AMG GT (2024)</option>
                                <option>Lamborghini Huracán EVO (2023)</option>
                                <option>Audi RS e-tron GT (2025)</option>
                                <option>Ferrari Roma (2023)</option>
                                <option>Range Rover SVAutobiography (2024)</option>
                                <option>Tesla Model S Plaid (2024)</option>
                                <option>Other / Not sure yet</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-[0.14em] text-neutral-500 mb-1.5 font-['DM_Sans',sans-serif]">
                                Message
                            </label>
                            <textarea @bind="form.Message" rows="4" placeholder="Tell us what you're looking for, your budget, or any questions you have…"
                                      class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] resize-y transition-colors"></textarea>
                        </div>

                        <button type="submit"
                                class="mt-1 py-4 font-semibold uppercase tracking-[0.14em] text-white bg-[#c8002a] hover:bg-red-700 transition-colors duration-200 cursor-pointer">
                            Submit Request
                        </button>
                    </form>
                }
            </div>

            @* Showroom Info *@
            <div class="flex flex-col gap-10">
                <div class="aspect-[4/3] bg-neutral-900 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1562141961-b8a3701571f1?w=800&h=600&fit=crop&auto=format"
                         alt="Apex Motors showroom"
                         class="w-full h-full object-cover" />
                </div>

                <div class="flex flex-col gap-6">
                    @foreach (var info in InfoList)
                    {
                        <div class="flex gap-6 items-start border-b border-neutral-900 pb-5">
                            <span class="shrink-0 text-xs uppercase tracking-[0.14em] pt-0.5 text-[#c8002a] font-['DM_Sans',sans-serif] min-w-16">
                                @info.Label
                            </span>
                            <span class="text-neutral-400 font-['DM_Sans',sans-serif] text-sm">
                                @info.Value
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isSubmitted = false;
    private ContactForm form = new();

    public class ContactForm
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Vehicle { get; set; } = "";
        public DateTime? Date { get; set; }
        public string Message { get; set; } = "";
    }

    public class CompanyInfo
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private List<CompanyInfo> InfoList = new()
    {
        new CompanyInfo { Label = "Address", Value = "4821 Motorway Blvd, Los Angeles, CA 90001" },
        new CompanyInfo { Label = "Phone", Value = "+1 (310) 555-0192" },
        new CompanyInfo { Label = "Email", Value = "hello@apexmotors.com" },
        new CompanyInfo { Label = "Hours", Value = "Mon–Sat 9am–7pm · Sun 11am–5pm" }
    };

    private void HandleSubmit() => isSubmitted = true;

    private void ResetForm()
    {
        isSubmitted = false;
        form = new ContactForm();
    }
}