@page "/inventory"

<div class="pt-24 max-w-6xl mx-auto px-8 pb-16">
    <div class="mb-12">
        <p class="text-sm uppercase tracking-[0.22em] mb-3 text-[#c8002a] font-['DM_Sans',sans-serif]">
            Browse
        </p>
        <h1 class="font-black uppercase leading-none mb-2 text-[#f0f0f0] font-['Barlow_Condensed',sans-serif] text-5xl md:text-7xl">
            Our Inventory
        </h1>
        <p class="text-neutral-500 font-['DM_Sans',sans-serif]">
            @FilteredCars.Count() vehicles available
        </p>
    </div>

    @* Search & Filters Header *@
    <div class="flex flex-col gap-6 mb-10 pb-8 border-b border-neutral-900">
        <div class="w-full">
            <input type="text" placeholder="Search by model or make..."
                   @bind="searchTerm" @bind:event="oninput"
                   class="w-full bg-[#111] border border-neutral-800 text-neutral-100 px-4 py-3 text-sm font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] transition-colors" />
        </div>

        <div class="flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
            <div class="flex flex-wrap gap-2">
                @foreach (var cat in Categories)
                {
                    <button @onclick="() => activeCategory = cat"
                            class="px-4 py-2 text-sm font-medium uppercase tracking-[0.12em] font-['DM_Sans',sans-serif] transition-colors duration-150 @(activeCategory == cat ? "bg-[#c8002a] text-white" : "bg-neutral-900 text-neutral-400 hover:text-white")">
                        @cat
                    </button>
                }
            </div>

            <div class="flex flex-wrap items-center gap-6">
                <div class="flex items-center gap-3">
                    <label class="text-xs uppercase tracking-[0.14em] text-neutral-500 font-['DM_Sans',sans-serif]">
                        Max Price
                    </label>
                    <span class="text-sm font-medium text-neutral-100 font-['DM_Sans',sans-serif] min-w-20">
                        @maxPrice.ToString("C0")
                    </span>
                    <input type="range" min="50000" max="300000" step="5000"
                           @bind="maxPrice" @bind:event="oninput"
                           class="w-28 accent-[#c8002a] cursor-pointer" />
                </div>

                <select @bind="sortOption"
                        class="px-4 py-2 text-sm font-medium bg-neutral-900 text-neutral-300 border border-neutral-800 font-['DM_Sans',sans-serif] outline-none focus:border-[#c8002a] cursor-pointer">
                    @foreach (var o in SortOptions)
                    {
                        <option value="@o">@o</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @* Cars Grid *@
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var car in FilteredCars)
        {
            <div class="group bg-[#111] border border-neutral-900 hover:border-neutral-700 transition-colors duration-300">
                <div class="overflow-hidden aspect-[16/10] bg-neutral-900">
                    <img src="@car.Img" alt="@car.Name"
                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <div class="p-5">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs px-2 py-0.5 uppercase tracking-[0.12em] bg-neutral-900 text-neutral-400 font-['DM_Sans',sans-serif]">
                            @car.Category
                        </span>
                        <span class="text-xs text-neutral-500 font-['DM_Sans',sans-serif]">
                            @car.Year · @car.Mileage
                        </span>
                    </div>
                    <h3 class="font-bold text-xl mb-1 text-neutral-200 group-hover:text-white font-['Barlow_Condensed',sans-serif] tracking-wide transition-colors">
                        @car.Name
                    </h3>
                    <div class="flex items-center justify-between mt-3">
                        <span class="font-black text-2xl text-neutral-100 font-['Barlow_Condensed',sans-serif]">
                            @car.Price.ToString("C0")
                        </span>
                        <span class="text-xs text-neutral-500 font-['DM_Sans',sans-serif]">
                            @car.Hp hp · @car.Transmission
                        </span>
                    </div>
                    <a href="/contact"
                       class="block mt-4 text-center py-3 text-sm font-semibold uppercase tracking-[0.14em] text-white bg-[#c8002a] hover:bg-red-700 transition-colors duration-200">
                        Enquire
                    </a>
                </div>
            </div>
        }
    </div>

    @if (!FilteredCars.Any())
    {
        <div class="text-center py-24">
            <p class="text-4xl font-black uppercase mb-2 text-neutral-700 font-['Barlow_Condensed',sans-serif]">
                No vehicles found
            </p>
            <p class="text-neutral-500 font-['DM_Sans',sans-serif]">Try adjusting your search query or filters.</p>
        </div>
    }
</div>

@code {
    private string searchTerm = "";
    private string activeCategory = "All";
    private string sortOption = "Price: Low to High";
    private decimal maxPrice = 300000;

    private List<string> Categories = new() { "All", "Sports", "Luxury", "Exotic", "Electric" };
    private List<string> SortOptions = new() { "Price: Low to High", "Price: High to Low", "Newest First", "Most Powerful" };

    public class Car
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public int Year { get; set; }
        public decimal Price { get; set; }
        public string Category { get; set; } = "";
        public string Mileage { get; set; } = "";
        public string Transmission { get; set; } = "";
        public int Hp { get; set; }
        public string Img { get; set; } = "";
    }

    private IEnumerable<Car> FilteredCars
    {
        get
        {
            var filtered = AllCars.Where(c =>
                (activeCategory == "All" || c.Category == activeCategory) &&
                c.Price <= maxPrice &&
                (string.IsNullOrWhiteSpace(searchTerm) || c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            );

            return sortOption switch
            {
                "Price: Low to High" => filtered.OrderBy(c => c.Price),
                "Price: High to Low" => filtered.OrderByDescending(c => c.Price),
                "Newest First" => filtered.OrderByDescending(c => c.Year),
                "Most Powerful" => filtered.OrderByDescending(c => c.Hp),
                _ => filtered
            };
        }
    }

    private List<Car> AllCars = new()
    {
        new Car { Id = 1, Name = "Porsche 911 GT3", Year = 2025, Price = 189500, Category = "Sports", Mileage = "0 mi", Transmission = "PDK", Hp = 510, Img = "https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?w=700&h=450&fit=crop&auto=format" },
        new Car { Id = 2, Name = "BMW M4 Competition", Year = 2024, Price = 94800, Category = "Sports", Mileage = "1,200 mi", Transmission = "Automatic", Hp = 503, Img = "https://images.unsplash.com/photo-1555215695-3004980ad54e?w=700&h=450&fit=crop&auto=format" },
        new Car { Id = 3, Name = "Mercedes AMG GT", Year = 2024, Price = 143200, Category = "Luxury", Mileage = "800 mi", Transmission = "Automatic", Hp = 577, Img = "https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?w=700&h=450&fit=crop&auto=format" },
        new Car { Id = 4, Name = "Lamborghini Huracán EVO", Year = 2023, Price = 261274, Category = "Exotic", Mileage = "3,400 mi", Transmission = "Automatic", Hp = 631, Img = "https://images.unsplash.com/photo-1544636331-e26879cd4d9b?w=700&h=450&fit=crop&auto=format" },
        new Car { Id = 5, Name = "Audi RS e-tron GT", Year = 2025, Price = 142400, Category = "Electric", Mileage = "0 mi", Transmission = "Automatic", Hp = 637, Img = "https://image-cdn.hypb.st/https%3A%2F%2Fhypebeast.com%2Fimage%2F2025%2F05%2F16%2Faudi-e-tron-gt-quattro-model-release-info-001.jpg?q=75&w=800&cbr=1&fit=max" },
        new Car { Id = 6, Name = "Ferrari Roma", Year = 2023, Price = 228995, Category = "Exotic", Mileage = "1,800 mi", Transmission = "Automatic", Hp = 612, Img = "https://images.unsplash.com/photo-1592198084033-aade902d1aae?w=700&h=450&fit=crop&auto=format" },
